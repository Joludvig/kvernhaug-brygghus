# modules/ingredient_normalizer.py
from modules.ingredient_matcher import generer_stabil_id

SMAKS_ORDBOK = {
    "pilsner": (["brød", "kjeks", "lyst korn", "honning"], {"Brød": 4, "Honning": 1, "Maltfylde": 3}, 100, "Lys Lager"),
    "pale": (["brødskorpe", "kjeks", "nøtter", "maltrik"], {"Brød": 5, "Toast": 3, "Nøtter": 2, "Maltfylde": 5}, 100, "Pale Ale"),
    "cara": (["karamell", "knekk", "mørkt sukker", "rosiner"], {"Karamell": 7, "Honning": 3, "Maltfylde": 4}, 25, "Bock / Juleøl"),
    "chocolate": (["mørk sjokolade", "kakao", "røstet kaffe"], {"Sjokolade": 8, "Kaffe": 5, "Toast": 4}, 10, "Stout / Porter"),
    "citra": (["pasjonsfrukt", "grapefrukt", "lime", "tropisk"], {"Sitrus": 8, "Fruktighet": 9, "Tropisk": 9}, 100, "IPA / Pale Ale"),
    "voss": (["appelsin", "sitrusskall", "fruktig"], {"Fruktighet": 7, "Sitrus": 6}, 100, "Norsk Gårdsøl")
}

import re as _re

def _rens_display_navn(navn):
    """Fjerner pakningsstørrelse og knust/hel fra visningsnavnet."""
    navn = _re.sub(r"^\d+(?:[.,]\d+)?\s*(?:kg|g|gr|gram)\s+", "", navn, flags=_re.IGNORECASE)
    navn = _re.sub(r"\s*[-–]\s*\d+(?:[.,]\d+)?\s*(?:kg|g|gr|gram)\b", "", navn, flags=_re.IGNORECASE)
    navn = _re.sub(r"\s+\d+(?:[.,]\d+)?\s*(?:kg|g|gr|gram)\b", "", navn, flags=_re.IGNORECASE)
    navn = _re.sub(r"\b(knust|crushed|hel|whole)\b", "", navn, flags=_re.IGNORECASE)
    return _re.sub(r"\s+", " ", navn).strip()

def _pris_per_kg(pris, pakke_gram, kategori=""):
    """Regner om råpris til kr/kg for malt/humle. Gjær returneres uendret (pris per pakke)."""
    if kategori == "gjaer":
        return pris
    if pakke_gram and pakke_gram > 0:
        return round(pris * (1000 / pakke_gram), 2)
    # Heuristikk: vestbrygg viser malt-priser per 100g uten å skrive det i navn/beskrivelse
    if kategori in ("malt", "spraymalt") and 0 < pris < 15:
        return round(pris * 10, 2)
    return pris

def ai_normaliser_tekst(raw_item):
    """Tolker tekstbeskrivelser lingvistisk for å bygge et komplett, sensorisk Master-objekt."""
    navn = raw_item["navn"].lower()
    desc = raw_item["beskrivelse"].lower()
    kategori = raw_item["kategori"]

    # Standardverdier
    smakstags = ["maltpreget"] if kategori == "malt" else ["humlearoma"]
    kategorier_poeng = {"Maltfylde": 3, "Brød": 2} if kategori == "malt" else {"Bitterhet": 5, "Sitrus": 2}
    maks_p = 100 if kategori != "malt" else 20
    stiler = ["Kreativt Brygg"]

    for nokkel, (tags, kats, mp, stil) in SMAKS_ORDBOK.items():
        if nokkel in navn or nokkel in desc:
            smakstags = tags
            kategorier_poeng = kats
            maks_p = mp
            stiler = [stil]
            break

    url = raw_item.get("url", "").lower()
    produsent = "Ukjent"
    for p_navn, nøkler in [
        ("Weyermann",      ["weyermann"]),
        ("Thomas Fawcett", ["thomas-fawcett", "thomas fawcett", "fawcett"]),
        ("Crisp Malting",  ["crisp"]),
        ("BestMalz",       ["bestmalz"]),
        ("Castle Malting", ["castle", "château", "chateau"]),
        ("Bonsak",         ["bonsak"]),
        ("Viking Malt",    ["viking"]),
        ("Fermentis",      ["fermentis", "safale", "saflager"]),
        ("Lallemand",      ["lallemand", "lalbrew"]),
        ("Wyeast",         ["wyeast"]),
        ("Mangrove Jack's",["mangrove"]),
    ]:
        if any(n in navn or n in desc or n in url for n in nøkler):
            produsent = p_navn
            break

    m_id = generer_stabil_id(raw_item["navn"])
    display_navn = _rens_display_navn(raw_item["navn"])
    er_knust = raw_item.get("er_knust", False)
    pris_norm = _pris_per_kg(raw_item["pris"], raw_item.get("pakke_gram"), kategori)

    master_struktur = {
        "display_name": display_navn,
        "produsent": produsent,
        "kategori": raw_item["kategori"],
        "smakstags": smakstags,
        "kategorier": kategorier_poeng,
        "maks_prosent": maks_p,
        "anbefalte_stiler": stiler,
        "knust_tilgjengelig": er_knust,
        "pris_vestbrygg": pris_norm if raw_item["butikk"] == "vestbrygg" else 0.0,
        "pris_olbrygging": pris_norm if raw_item["butikk"] == "olbrygging" else 0.0,
    }

    if kategori == "malt":
        ebc = raw_item["ebc"]
        master_struktur["ebc"] = ebc
        if ebc <= 10:
            master_struktur["potensiale"] = 1.037
        elif ebc <= 50:
            master_struktur["potensiale"] = 1.034
        elif ebc <= 150:
            master_struktur["potensiale"] = 1.030
        else:
            master_struktur["potensiale"] = 1.025
        master_struktur["kategori"] = _malt_kategori(navn)
    if kategori == "humle": master_struktur["alfa"] = raw_item["alfa"]
    if kategori == "gjaer":
        master_struktur["attenuation"] = raw_item["attenuation"]
        master_struktur["pris_per_pakke"] = raw_item["pris"]

    return m_id, master_struktur
