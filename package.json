{
  "name": "kvernhaug-brygghus-web-browser-gate",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright Critical Browser Gate (issue #200) -- devDependency only, does not affect the dependency-free web/ runtime.",
  "scripts": {
    "test:browser-gate": "playwright test",
    "test:bryggeskole-svg-runtime": "playwright test --config=playwright.streamlit.config.js",
    "test:bryggeskole-grid-runtime": "playwright test --config=playwright.bryggeskole-grid.config.js",
    "test:bryggeskole-quiz-contrast-runtime": "playwright test --config=playwright.bryggeskole-quiz-contrast.config.js",
    "test:bryggeskole-stage-progress-runtime": "playwright test --config=playwright.bryggeskole-stage-progress.config.js --pass-with-no-tests",
    "test:bryggeskole-stage-final-runtime": "playwright test --config=playwright.bryggeskole-stage-final.config.js --pass-with-no-tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
