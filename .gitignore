# Python cache
__pycache__/
*.pyc
*.pyo

# Editor temp files (Claude Code / VSCode)
*.tmp
*.tmp.*

# Virtual environment
.venv/

# IDE og tool-konfig
.vscode/
.claude/

# Utviklerverktøy og testscripts
backup/
tools/
raw_data/*.txt

# Private brukerdata — ikke del disse
# Ankret til rotnivå (leading slash) med vilje: en uankret "recipes/" matcher
# ENHVER mappe med det navnet i hele treet, inkl. tests/fixtures/recipes/ —
# som er committede, saniterte test-fixtures og IKKE skal ignoreres.
/recipes/
/recipes_backup_*/
data/humle_lager.json
data/equipment.json
data/pantry.json
data/pantry.json.tmp
data/pantry.json.backup_*

# Backup-artefakter
data/*.bak
# Automatiske, tidsstemplede backuper av masterdata (se
# modules/master_data_io.py::backup_master_fil()) -- masterfilene selv ER
# versjonskontrollerte; disse er kun et lokalt sikkerhetsnett mellom to commits.
data/*.json.backup_*

# Loggfiler og temp
*.log
c:*

# Store lokale originalfiler (ikke nødvendig for andre brukere)
Master V1.png
assets/branding/master_v1_crop.png
